{
  "ci": {
    "collect": {
      "startServerCommand": "npm run start -- --port 3200",
      "startServerReadyPattern": "Ready",
      "url": [
        "http://localhost:3200/en",
        "http://localhost:3200/pt-br/boxes",
        "http://localhost:3200/en/start",
        "http://localhost:3200/en/boxes"
      ],
      "numberOfRuns": 5
    },
    "assert": {
      "assertMatrix": [
        {
          "matchingUrlPattern": ".*/en/start$",
          "assertions": {
            "largest-contentful-paint": [
              "error",
              {
                "maxNumericValue": 3800,
                "aggregationMethod": "median-run"
              }
            ],
            "cumulative-layout-shift": [
              "error",
              {
                "maxNumericValue": 0.02,
                "aggregationMethod": "median-run"
              }
            ],
            "total-blocking-time": [
              "error",
              {
                "maxNumericValue": 200,
                "aggregationMethod": "median-run"
              }
            ],
            "resource-summary:script:size": [
              "error",
              {
                "maxNumericValue": 175000,
                "aggregationMethod": "median-run"
              }
            ]
          }
        },
        {
          "matchingUrlPattern": "^(?!.*/start).*$",
          "assertions": {
            "largest-contentful-paint": [
              "error",
              {
                "maxNumericValue": 3800,
                "aggregationMethod": "median-run"
              }
            ],
            "cumulative-layout-shift": [
              "error",
              {
                "maxNumericValue": 0.02,
                "aggregationMethod": "median-run"
              }
            ],
            "total-blocking-time": [
              "error",
              {
                "maxNumericValue": 120,
                "aggregationMethod": "median-run"
              }
            ],
            "resource-summary:script:size": [
              "error",
              {
                "maxNumericValue": 182000,
                "aggregationMethod": "median-run"
              }
            ]
          }
        }
      ]
    },
    "upload": {
      "target": "filesystem",
      "outputDir": ".lighthouseci/reports"
    }
  }
}
