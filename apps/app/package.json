{
  "name": "app",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev --port 3200",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "next typegen && tsc --noEmit",
    "test": "vitest run && node --test scripts/*.test.mjs",
    "test:responsive": "playwright test",
    "test:perf": "npm run build && lhci autorun",
    "test:live": "vitest run --config vitest.live.config.mts --passWithNoTests",
    "test:e2e:live": "playwright test --config playwright.live.config.ts --pass-with-no-tests"
  },
  "dependencies": {
    "@strickle/core": "*",
    "@strickle/design": "*",
    "@strickle/tax-engine": "*",
    "next": "16.4.1",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "server-only": "^0.0.1",
    "zod": "3.25.76"
  },
  "devDependencies": {
    "@lhci/cli": "^0.15.1",
    "@playwright/test": "^1.64.1",
    "@strickle/gates": "*",
    "@tailwindcss/turbopack": "^4",
    "@types/node": "^24",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.4.1",
    "tailwindcss": "^4",
    "typescript": "^5",
    "vitest": "^5.0.4"
  }
}
