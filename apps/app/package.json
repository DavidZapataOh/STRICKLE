{
  "name": "app",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev --port 3200",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "next typegen && tsc --noEmit",
    "test": "vitest run && node --test scripts/*.test.mjs",
    "test:responsive": "playwright test --grep-invert @quote",
    "test:quote": "playwright test --grep @quote --workers=1",
    "test:perf": "npm run build && lhci autorun",
    "test:live": "vitest run --config vitest.live.config.mts --passWithNoTests",
    "test:e2e:live": "playwright test --config playwright.live.config.ts --pass-with-no-tests",
    "predev": "node scripts/sync-deployments.mjs",
    "prebuild": "node scripts/sync-deployments.mjs",
    "test:integration": "vitest run --config vitest.integration.config.mts",
    "wave": "node --env-file-if-exists=../../../.env scripts/wave.ts",
    "record-metrics": "node --env-file-if-exists=../../../.env scripts/record-metrics.ts"
  },
  "dependencies": {
    "@circle-fin/onramp-kit": "1.0.4",
    "@noble/curves": "2.4.0",
    "@noble/hashes": "2.4.0",
    "@strickle/agent": "*",
    "@strickle/arc": "*",
    "@strickle/brain": "*",
    "@strickle/core": "*",
    "@strickle/db": "*",
    "@strickle/design": "*",
    "@strickle/pool": "*",
    "@strickle/prover": "*",
    "@strickle/tax-engine": "*",
    "next": "16.4.1",
    "postgres": "^3.4.9",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "server-only": "^0.0.1",
    "viem": "^2.57.7",
    "zod": "3.25.76"
  },
  "devDependencies": {
    "@lhci/cli": "^0.15.1",
    "@playwright/test": "^1.64.1",
    "@strickle/gates": "*",
    "@tailwindcss/turbopack": "^4",
    "@types/node": "^24",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.4.1",
    "fake-indexeddb": "^6.0.0",
    "tailwindcss": "^4",
    "typescript": "^5",
    "vitest": "^5.0.4"
  }
}
