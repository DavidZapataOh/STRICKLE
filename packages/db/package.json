{
  "name": "@strickle/db",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./limiter": "./src/limiter.ts",
    "./access": "./src/access.ts",
    "./testing": "./src/testing.ts",
    "./connect": "./src/connect.ts",
    "./snapshots": "./src/snapshots.ts"
  },
  "scripts": {
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:integration": "vitest run --config vitest.integration.config.mts",
    "migrate": "node --env-file-if-exists=../../../.env src/migrate-cli.ts",
    "db:ping": "node --env-file-if-exists=../../../.env src/ping-cli.ts"
  },
  "dependencies": {
    "@strickle/core": "*",
    "postgres": "^3.4.9"
  },
  "devDependencies": {
    "vitest": "^5.0.4"
  }
}
