{
  "name": "@strickle/arc",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./networks": "./src/networks.ts",
    "./passkey": "./src/passkey.ts",
    "./sponsorship": "./src/sponsorship.ts",
    "./probe": "./src/probe.ts",
    "./usdc": "./src/usdc.ts",
    "./bridge": "./src/bridge/index.ts",
    "./bridge/chains": "./src/bridge/chains.ts",
    "./bridge/types": "./src/bridge/types.ts",
    "./bridge/iris": "./src/bridge/iris.ts"
  },
  "scripts": {
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
