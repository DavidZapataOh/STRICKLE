    "register-entity-secret": "node --env-file-if-exists=../../../.env src/register-entity-secret-cli.ts",
    "setup-gas-station-wallets": "node --env-file-if-exists=../../../.env src/setup-gas-station-wallets-cli.ts",
    "probe": "node --env-file-if-exists=../../../.env src/probe-cli.ts"
  },
  "dependencies": {
    "@circle-fin/adapter-viem-v2": "1.19.1",
    "@circle-fin/bridge-kit": "1.15.3",
