# Circle Console, developer-controlled wallets. One pair per environment.
CIRCLE_API_KEY_TESTNET=
CIRCLE_ENTITY_SECRET_TESTNET=
CIRCLE_API_KEY_MAINNET=
CIRCLE_ENTITY_SECRET_MAINNET=

# Testnet wallets used by the Gas Station check (printed by setup-gas-station-wallets)
CIRCLE_GAS_STATION_SCA_WALLET_ID=
CIRCLE_GAS_STATION_EOA_WALLET_ID=

# Optional RPC overrides (empty means the public default)
ARC_TESTNET_RPC_URL=
ARC_MAINNET_RPC_URL=
