# Strickle needs no environment variable to run the local network.
# Every entry below is an optional override: copy this file to .env only when
# you need one, and export it in your shell or load it yourself. Nothing in the
# repository reads .env automatically.

# GraphQL indexer endpoint (http or https). Default: http://127.0.0.1:8088/api/v4/graphql
MIDNIGHT_INDEXER_URL=
# Indexer subscription endpoint (ws or wss). Default: ws://127.0.0.1:8088/api/v4/graphql/ws
MIDNIGHT_INDEXER_WS_URL=
# Midnight node RPC (ws or wss). Default: ws://127.0.0.1:9944
MIDNIGHT_NODE_URL=
# Proof server (http or https). Default: http://127.0.0.1:6300
MIDNIGHT_PROOF_SERVER_URL=
# Faucet of a funded network (http or https). The local network has none.
MIDNIGHT_FAUCET_URL=
# How long to wait for faucet funds, in milliseconds. Default: 600000
MIDNIGHT_FAUCET_TIMEOUT_MS=
# Password that encrypts the private state, at least 16 characters. A local placeholder is used when unset.
PRIVATE_STATE_PASSWORD=
# Wallet seed, hexadecimal. Ignored on the local network, which uses its genesis seed.
MIDNIGHT_WALLET_SEED=
# Wallet recovery phrase, 24 words. An alternative to the seed; setting both is an error.
MIDNIGHT_WALLET_MNEMONIC=
