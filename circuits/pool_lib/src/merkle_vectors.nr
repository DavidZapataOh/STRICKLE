    let path = [0x0b951bc726c1978c7729a47f05f8181b2f253c1c17728c09063b9ba4b35b42aa, 0x02712ce1afbfc3ac0621e6cdbfca738bd16e7da990423644bd580f102ad6bc3e, 0x0e34ac2c09f45a503d2908bcb12f1cbae5fa4065759c88d501c097506a8b2290, 0x06fcaea0b0f7d7e181cfadbf50221ea1ec4ea749455a272b1c134a60a5247a68, 0x2373ea368857ec7af97e7b470d705848e2bf93ed7bef142a490f2119bcf82d8e, 0x120157cfaaa49ce3da30f8b47879114977c24b266d58b0ac18b325d878aafddf, 0x01c28fe1059ae0237b72334700697bdf465e03df03986fe05200cadeda66bd76, 0x2d78ed82f93b61ba718b17c2dfe5b52375b4d37cbbed6f1fc98b47614b0cf21b, 0x067243231eddf4222f3911defbba7705aff06ed45960b27f6f91319196ef97e1, 0x1849b85f3c693693e732dfc4577217acc18295193bede09ce8b97ad910310972];
    assert_eq(compute_root(0x26ed302dcf9f1d5cf2231388e698c7e51640cae647537d1abebf33ec230cf88a, 11, path), 0x1b007a3f5069b6da26e311e80676895c92cc4765d811a34bf4b807d37299e223);
}

