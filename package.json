{
  "name": "strickle",
  "private": true,
  "engines": {
    "node": ">=24"
  },
  "workspaces": [
    "apps/*",
    "packages/*",
    "workflows/*",
    "contracts"
  ],
  "scripts": {
    "lint": "npm run lint --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "test": "npm run test --workspaces --if-present && node --test \"scripts/*.test.mjs\"",
    "build": "npm run build --workspaces --if-present",
    "db:up": "docker compose up -d --wait db",
    "db:down": "docker compose down",
    "toolchain:install": "node scripts/toolchain.mjs install",
    "toolchain:verify": "node scripts/toolchain.mjs verify",
    "pool:vectors": "npm run vectors -w @strickle/pool",
    "circuits:test": "node scripts/toolchain.mjs run --cwd circuits nargo test --workspace",
    "circuits:compile": "node scripts/toolchain.mjs run --cwd circuits nargo compile --workspace",
    "circuits:verifiers": "node scripts/verifiers.mjs generate",
    "circuits:verifiers:check": "node scripts/verifiers.mjs check",
    "circuits:fixtures": "npm run fixtures -w @strickle/pool",
    "circuits:scenario": "npm run scenario -w @strickle/pool",
    "pool:abi": "node scripts/pool-abi.mjs",
    "pool:live": "npm run live -w @strickle/pool"
  },
  "devDependencies": {
    "@types/node": "^24",
    "eslint": "^9",
    "typescript": "^5",
    "typescript-eslint": "^8"
  }
}
